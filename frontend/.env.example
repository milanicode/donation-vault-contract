# Copy to .env.local and fill in. Every value here ends up in the public
# browser bundle, so never put a private key or a paid RPC secret in this file.

# Network: 11155111 = Sepolia portfolio (three campaigns in src/config/campaigns.ts),
# 31337 = a single local Anvil vault.
VITE_CHAIN_ID=11155111

# Single-vault address. Required for the Anvil preview. Ignored on Sepolia,
# where the three portfolio contracts are listed in source.
VITE_VAULT_ADDRESS=

# Optional. First block scanned for Deposit events on the Anvil vault.
# Each Sepolia campaign carries its own deploy block in src/config/campaigns.ts.
VITE_DEPLOY_BLOCK=

# Optional. RPC endpoint used for reading. Defaults to the chain's public RPC
# (Sepolia) or http://127.0.0.1:8545 (Anvil). Public endpoints are rate-limited.
VITE_RPC_URL=

# Optional. Largest block range requested per eth_getLogs call (default 10000).
# Lower it if your RPC provider rejects the donor-list query.
VITE_LOGS_CHUNK_SIZE=

# Optional. Title and description of the single Anvil campaign.
VITE_CAMPAIGN_TITLE=
VITE_CAMPAIGN_DESCRIPTION=

# Optional link shown in the footer and on the contract section.
VITE_REPO_URL=
